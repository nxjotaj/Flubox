# Supabase e PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Integrações externas (mantenha vazias enquanto não contratadas)
PAYMENT_PROVIDER=development
PAYMENT_PROVIDER_SECRET=
PIX_PROVIDER_SECRET=
LOGISTICS_PROVIDER_SECRET=
EMAIL_PROVIDER_SECRET=

# Contas e auditorias locais
TEST_ACCOUNT_PASSWORD=troque-esta-senha
SMOKE_PASSWORD=troque-esta-senha
SMOKE_BASE_URL=http://localhost:3000

# Canais de venda (mock enquanto os aplicativos não forem homologados)
INTEGRATIONS_MODE=mock
MERCADO_LIVRE_ENABLED=true
SHOPEE_ENABLED=true
INTEGRATIONS_ENCRYPTION_KEY=
INTEGRATIONS_WEBHOOK_SECRET=
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
