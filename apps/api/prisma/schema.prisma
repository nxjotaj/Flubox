generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SELLER
  OPERATOR
}

enum UserStatus {
  PENDING_EMAIL
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  DELETED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  DOCUMENTS_PENDING
  PAID
  SEPARATING
  READY_TO_SHIP
  SHIPPED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  EXPIRED
  REVIEW
  REJECTED
  REFUND_PENDING
  REFUNDED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum FileKind {
  PRODUCT_IMAGE
  PRODUCT_ATTACHMENT
  PAYMENT_RECEIPT
  SHIPPING_LABEL
  INVOICE
  CONTENT_DECLARATION
  EXPORT
}

enum StockMovementType {
  ENTRY
  RESERVATION
  RELEASE
  ADJUSTMENT
  SHIPMENT
  RETURN
  LOSS
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  name String
  companyName String?
  taxId String?
  phone String?
  role Role @default(SELLER)
  status UserStatus @default(PENDING_EMAIL)
  emailVerifiedAt DateTime?
  approvedAt DateTime?
  approvedById String?
  suspendedAt DateTime?
  deletedAt DateTime?
  privacyAcceptedAt DateTime?
  termsAcceptedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  orders Order[] @relation("SellerOrders")
  files FileObject[]
  notifications Notification[]
  stockMovements StockMovement[]
  auditLogs AuditLog[] @relation("ActorAuditLogs")
  @@index([role, status])
  @@index([companyName])
}

model Session {
  id String @id @default(uuid())
  userId String
  refreshTokenHash String @unique
  userAgent String?
  ipHash String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model PasswordReset {
  id String @id @default(uuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model Product {
  id String @id @default(uuid())
  sku String @unique
  name String
  description String
  category String
  brand String?
  condition String @default("new")
  price Decimal @db.Decimal(12,2)
  stockOnHand Int @default(0)
  reservedStock Int @default(0)
  lowStockThreshold Int @default(5)
  weightGrams Int
  lengthMm Int
  widthMm Int
  heightMm Int
  packageWeightGrams Int?
  packageLengthMm Int?
  packageWidthMm Int?
  packageHeightMm Int?
  gtin String?
  ncm String?
  attributes Json @default("{}")
  status ProductStatus @default(DRAFT)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?
  variants ProductVariant[]
  files FileObject[]
  orderItems OrderItem[]
  reservations Reservation[]
  stockMovements StockMovement[]
  @@index([status, category])
  @@index([name])
}

model ProductVariant {
  id String @id @default(uuid())
  productId String
  sku String @unique
  name String
  price Decimal? @db.Decimal(12,2)
  attributes Json @default("{}")
  stockOnHand Int @default(0)
  reservedStock Int @default(0)
  active Boolean @default(true)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  @@index([productId, active])
}

model Order {
  id String @id @default(uuid())
  number String @unique
  sellerId String
  recipientName String
  recipientTaxId String?
  recipientAddress Json
  total Decimal @db.Decimal(12,2)
  status OrderStatus @default(DRAFT)
  trackingCode String?
  shippingNotes String?
  reservationExpiresAt DateTime?
  shippedAt DateTime?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seller User @relation("SellerOrders", fields: [sellerId], references: [id])
  items OrderItem[]
  reservations Reservation[]
  payments Payment[]
  files FileObject[]
  statusHistory OrderStatusHistory[]
  stockMovements StockMovement[]
  @@index([sellerId, status, createdAt])
  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id String @id @default(uuid())
  orderId String
  productId String
  variantId String?
  sku String
  name String
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  @@index([orderId])
}

model Reservation {
  id String @id @default(uuid())
  orderId String
  productId String
  quantity Int
  status ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@index([status, expiresAt])
  @@index([orderId])
}

model Payment {
  id String @id @default(uuid())
  orderId String
  provider String
  providerChargeId String
  amount Decimal @db.Decimal(12,2)
  status PaymentStatus @default(PENDING)
  pixCopyPaste String?
  qrCodeKey String?
  expiresAt DateTime?
  confirmedAt DateTime?
  reviewReason String?
  receiptExtraction Json?
  receiptConfidence Decimal? @db.Decimal(5,4)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id])
  @@unique([provider, providerChargeId])
  @@index([orderId, status])
}

model FileObject {
  id String @id @default(uuid())
  ownerId String
  productId String?
  orderId String?
  kind FileKind
  storageKey String @unique
  filename String
  contentType String
  sizeBytes Int
  checksum String
  primary Boolean @default(false)
  scanStatus String @default("pending")
  retentionUntil DateTime?
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id])
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, kind])
  @@index([productId, kind])
}

model StockMovement {
  id String @id @default(uuid())
  productId String
  orderId String?
  actorId String
  type StockMovementType
  quantity Int
  balanceAfter Int
  reason String
  reference String?
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])
  actor User @relation(fields: [actorId], references: [id])
  @@index([productId, createdAt])
  @@index([orderId])
}

model OrderStatusHistory {
  id String @id @default(uuid())
  orderId String
  fromStatus OrderStatus?
  toStatus OrderStatus
  actorId String
  reason String?
  metadata Json?
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, createdAt])
}

model Notification {
  id String @id @default(uuid())
  userId String
  channel NotificationChannel
  type String
  title String
  body String
  status String @default("pending")
  readAt DateTime?
  attempts Int @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, createdAt])
}

model AuditLog {
  id String @id @default(uuid())
  actorId String?
  entityType String
  entityId String
  action String
  reason String?
  before Json?
  after Json?
  ipHash String?
  createdAt DateTime @default(now())
  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model WebhookEvent {
  id String @id @default(uuid())
  provider String
  externalId String
  type String
  payloadHash String
  processedAt DateTime?
  error String?
  createdAt DateTime @default(now())
  @@unique([provider, externalId])
}

model PlatformSettings {
  id String @id @default("default")
  companyName String @default("")
  taxId String @default("")
  phone String @default("")
  email String @default("")
  pickupAddress Json @default("{}")
  pixMode String @default("MANUAL")
  pixKey String @default("")
  pixBeneficiary String @default("")
  pixCity String @default("")
  pixProvider String @default("SIMULATED")
  pixApiUrl String @default("")
  pixApiTokenEncrypted String @default("")
  updatedById String?
  updatedAt DateTime @updatedAt
}
